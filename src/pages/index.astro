---
import Base from '../layouts/Base.astro';
import Painel from '../components/Painel.astro';
import { waLink } from '../site';
import clientes from '../clientes.json';
const wa = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.28-.1-.48-.15-.68.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.89 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.48-8.41"/></svg>';
---
<Base title="Consultoria Comercial Inteligente | Portilho Inteligência Comercial" description="Consultoria Comercial Inteligente para empresas que já vendem e querem vender mais. Damos clareza ao comercial (processos, equipe e indicadores) com a inteligência artificial integrada desde o início, e implementamos junto com você.">

<div class="historia">
  <div class="texto">
    <!-- Passo 0 — blocos 2 e 3 -->
    <section class="passo" data-passo="0">
      <span class="rot">Consultoria Comercial Inteligente</span>
      <h1>A IA já mudou como o seu cliente compra. Nós implementamos essa mudança no seu comercial.</h1>
      <p class="lead">Sua empresa pode vender mais. O que trava é um comercial sem clareza.</p>
      <div class="ctas"><a class="btn" href={waLink()} data-ev="whatsapp"><Fragment set:html={wa} />Conversar no WhatsApp</a></div>
      <p class="gratis">A primeira conversa é gratuita.</p>
      <Painel estado={0} inline />
    </section>
    <!-- Passo 1 — bloco 5 (portas + frase D) -->
    <section class="passo" data-passo="1" id="problema">
      <h2>Quando a venda não cresce, o dono pensa em contratar ou investir mais.</h2>
      <ul class="falas">
        <li>“Preciso contratar.”</li>
        <li>“Investi e não voltou.”</li>
        <li>“Vivo apagando incêndio.”</li>
      </ul>
      <p class="virada">Quase sempre, a venda que falta já chegou e se perdeu no caminho.</p>
      <Painel estado={1} inline />
    </section>
    <!-- Passo 2 — bloco 6 -->
    <section class="passo" data-passo="2">
      <h2>O dono enxerga quanto vendeu, mas não quanto deixou de vender.</h2>
      <p class="lead">Damos visibilidade ao comercial e fechamos as brechas, para a empresa converter mais as oportunidades que já gera.</p>
      <p class="dado">Segundo a Salesforce, implantar um CRM pode aumentar as vendas em até 29%.</p>
      <Painel estado={2} inline />
    </section>
  </div>
  <div class="lado"><div class="fixo"><Painel estado={0} id="painel" /></div></div>
</div>


<!-- Soluções — relatório da Fluir, 4.4 e "O que fica desta construção" -->
<section class="solucoes" id="solucoes">
  <div class="wrap">
    <div class="sol-topo">
      <div>
        <span class="rot">Soluções</span>
        <h2>Empresas chegam em momentos diferentes.</h2>
      </div>
      <p class="frase-fluir">A Auditoria indica o estágio. O estágio indica a prioridade. A prioridade indica a solução.</p>
    </div>
    <ol class="escada2">
      <li class="d1">
        <div class="deg">
          <span class="num">1</span>
          <span class="etapa">Entrada</span>
          <h3>Auditoria Comercial</h3>
          <p class="sub2">Mede o que a empresa nunca mediu.</p>
          <ul><li>Raio-X da base de clientes</li><li>Teste de rota: entramos como cliente e medimos a resposta</li><li>Conta do vazamento e plano de 12 meses</li></ul>
        </div>
      </li>
      <li class="d2">
        <div class="deg dest">
          <span class="num">2</span>
          <span class="etapa">Principal</span>
          <h3>Consultoria Comercial Inteligente</h3>
          <p class="sub2">Estruturar e implementar.</p>
          <ul><li>Processos comerciais, funil e CRM</li><li>Metas, indicadores e rotina de gestão</li><li>Equipe, liderança e implementação</li></ul>
        </div>
      </li>
      <li class="d3">
        <div class="deg">
          <span class="num">3</span>
          <span class="etapa">Continuidade</span>
          <h3>Gestão e Inteligência</h3>
          <p class="sub2">Acompanhar, interpretar e evoluir.</p>
          <ul><li>Leitura de indicadores</li><li>Reuniões estratégicas</li><li>Apoio a decisões de crescimento</li></ul>
        </div>
      </li>
    </ol>
  </div>
</section>

<!-- Clientes — mesma lista e título do site comercialinteligente.com.br -->
<section class="clientes" aria-labelledby="t-cli">
  <h2 id="t-cli">Empresas que confiam</h2>
  <ul class="logos wrap">
    {clientes.map((c) => (<li><img src={`/img/clientes/${c.k}.webp`} alt={c.n} width={c.w} height={c.h} loading="lazy" /></li>))}
  </ul>
</section>

<!-- Casos — Colorado Embalagens (dados do Jhonatan, 05/11) e MetalKit (bloco 8) -->
<section class="caso" id="caso">
  <div class="wrap">
    <span class="rot">Casos reais</span>
    <article class="caso1">
      <div class="numero">
        <img class="caso-logo" src="/img/clientes/colorado.webp" alt="Colorado Embalagens" width="400" height="75" loading="lazy" />
        <b><span id="cont" data-fim="72.77" data-pre="+" data-suf="%">+0,00%</span></b>
        <small>de faturamento com a continuidade da consultoria</small>
        <dl class="metricas">
          <div><dt>Faturamento nos primeiros 8 meses</dt><dd>+37,67%</dd></div>
          <div><dt>Lucro bruto</dt><dd>26,84% → 33,01%</dd></div>
          <div><dt>Lucro líquido</dt><dd>8% → 11%</dd></div>
        </dl>
      </div>
      <div class="caso-txt">
        <p>Os vendedores atendiam de forma limitada uma rota, e isso impedia a empresa de crescer mais.</p>
        <p>Reconfiguramos a forma como os vendedores atendiam os clientes e como isso era controlado. Alteramos o processo, treinamos os vendedores, implantamos novas rotinas e avaliamos o resultado.</p>
      </div>
    </article>
    <article class="caso2">
      <div class="numero mini">
        <img class="caso-logo" src="/img/clientes/metalkit.webp" alt="MetalKit" width="244" height="103" loading="lazy" />
        <b>+16,67%</b>
        <small>de faturamento no mês seguinte</small>
      </div>
      <div class="caso-txt">
        <p>Levantamos a carteira inteira — quem comprava sempre, quem comprou uma vez e parou, quem nunca comprou.</p>
        <p>Com essa informação na mão, a liderança passou a cobrar posição todos os dias. O aumento veio da base que já era dela.</p>
      </div>
    </article>
  </div>
</section>

<!-- Método PCG — relatório da Fluir, 4.1 e 4.2 -->
<section class="metodo" id="metodo">
  <div class="wrap">
    <span class="rot">Método PCG</span>
    <h2 class="met-h">Processos organizam. Cultura sustenta. Dados orientam.</h2>
    <div class="pcg-diag">
      <article class="pil">
        <span class="letra">P</span>
        <h3>Processos</h3>
        <p>Organizam a forma como a operação comercial acontece.</p>
        <div class="chips"><span>Fluxos comerciais</span><span>Funil</span><span>CRM</span><span>Rotinas</span><span>Padrões de atendimento</span></div>
      </article>
      <span class="liga" aria-hidden="true"></span>
      <article class="pil">
        <span class="letra">C</span>
        <h3>Cultura</h3>
        <p>Sustenta o processo no comportamento real da empresa.</p>
        <div class="chips"><span>Responsabilidades</span><span>Liderança</span><span>Acompanhamento</span><span>Rotina de gestão</span></div>
      </article>
      <span class="liga" aria-hidden="true"></span>
      <article class="pil">
        <span class="letra">G</span>
        <h3>Gestão com Inteligência de Dados</h3>
        <p>Transforma informação em capacidade de decisão.</p>
        <div class="chips"><span>Metas</span><span>Indicadores</span><span>Conversão</span><span>Ticket</span><span>Previsibilidade</span></div>
      </article>
    </div>
  </div>
</section>

<!-- Para quem — relatório da Fluir, 5.2 -->
<section class="paraquem">
  <div class="wrap">
    <div>
      <span class="rot">Para quem</span>
      <h2>Empresas em que o crescimento aconteceu antes da estrutura.</h2>
    </div>
    <ul class="sintomas">
      <li>Já possui operação comercial, equipe e vendas acontecendo.</li>
      <li>Chegou a um nível em que o improviso começa a cobrar um preço.</li>
      <li>Possui dependência relevante do proprietário ou de pessoas-chave.</li>
    </ul>
  </div>
</section>

<!-- Quem conduz — perfil GAINS do BNI (04/11/2026) + relatório da Fluir (3.4, 5.4, 6.1) -->
<section class="quem" id="quem">
  <div class="wrap quem2">
    <div class="foto"><picture><source srcset="/img/jhonatan-hero.webp" type="image/webp" /><img src="/img/jhonatan-hero.jpg" alt="Jhonatan Martins Portilho" width="1120" height="1400" loading="lazy" /></picture></div>
    <div>
      <span class="rot">Quem conduz</span>
      <h2>Jhonatan abre a relação. A Portilho sustenta a entrega.</h2>
      <p class="nome">Jhonatan Martins Portilho, fundador · consultor desde 2015</p>
      <div class="quem-num"><div><b>+800</b><span>empresas atendidas</span></div><div><b>+5.000</b><span>horas de consultoria</span></div></div>
      <p>Formado em Administração, com especialização em Estratégia Comercial, foi consultor do SEBRAE, servidor público concursado e gerente de negócios bancário antes de fundar a Portilho. Atende indústrias familiares, distribuidoras atacadistas e prestadoras de serviço no Paraná, em Santa Catarina e no Paraguai.</p>
      <ol class="linha-tempo">
        <li><b>21 anos</b><span>Empreendeu pela primeira vez</span></li>
        <li><b>2015</b><span>Começou a carreira de consultor</span></li>
        <li><b>2024</b><span>A Portilho se torna empresa de consultoria</span></li>
      </ol>
      <p>Dos 8 aos 17 anos, acompanhava a mãe quase todos os dias nas compras no Paraguai. Cresceu entre árabes, chineses, paraguaios, indianos e argentinos, e ali se apaixonou por empreendedorismo.</p>
      <blockquote class="paixao">“A minha paixão é observar e aprender sobre o comportamento humano. Flertar com a linha tênue entre entender a mente humana e vivenciar o caos nela. Meu paradoxo favorito: criar lógicas e equações para analisar o comportamento humano em vendas, que eu sei bem, passa longe de ser uma ciência exata.”</blockquote>
      <div class="atua">
        <span class="atua-t">Competências</span>
        <div class="chips claros"><span>Estratégia Comercial</span><span>Inteligência de Dados</span><span>Processos empresariais</span><span>Planejamento estratégico</span><span>Design conversacional com IA</span><span>Produtividade</span><span>Psicanálise</span><span>PNL</span><span>Direito tributário</span></div>
      </div>
      <p class="sela">Sua principal força está na capacidade de observar uma operação, identificar padrões, fazer perguntas relevantes e transformar complexidade em clareza para decisão.</p>
    </div>
  </div>
</section>

<!-- Fechamento -->
<section class="fim">
  <div class="wrap fim-centro">
    <img class="fim-logo" src="/img/logo_azul.png" alt="Portilho Inteligência Comercial" width="720" height="129" loading="lazy" />
    <div class="ctas"><a class="btn" href={waLink()} data-ev="whatsapp"><Fragment set:html={wa} />Conversar no WhatsApp</a></div>
  </div>
</section>

<script>
// painel fixo muda de estado conforme o passo da história na tela
const painel = document.getElementById('painel');
const agora = painel?.querySelector('.agora');
const falas = document.querySelectorAll('.falas li');
const io = new IntersectionObserver((es) => {
  for (const e of es) {
    if (!e.isIntersecting || !painel) continue;
    const n = (e.target as HTMLElement).dataset.passo!;
    painel.dataset.estado = n;
    if (agora) agora.textContent = n === '2' ? 'com a Portilho' : 'este mês';
  }
}, { rootMargin: '-45% 0px -45% 0px' });
document.querySelectorAll('.passo').forEach((p) => io.observe(p));
// falas do dono acendem uma a uma
const io2 = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) e.target.classList.add('on'); }), { rootMargin: '0px 0px -35% 0px' });
falas.forEach((f) => io2.observe(f));
// número do caso sobe quando aparece
const cont = document.getElementById('cont');
const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
const fmt = (v: number) => (cont!.dataset.pre || '') + v.toFixed(2).replace('.', ',') + (cont!.dataset.suf || '');
if (cont) new IntersectionObserver((es, o) => {
  if (!es[0].isIntersecting) return; o.disconnect();
  const fim = Number(cont.dataset.fim);
  if (reduz) { cont.textContent = fmt(fim); return; }
  const t0 = performance.now();
  const passo = (t: number) => { const k = Math.min(1, (t - t0) / 1800); cont.textContent = fmt(fim * (1 - Math.pow(1 - k, 3))); if (k < 1) requestAnimationFrame(passo); };
  requestAnimationFrame(passo);
}, { threshold: .6 }).observe(cont);
</script>
</Base>
